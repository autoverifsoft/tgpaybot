# Токен от @BotFather
BOT_TOKEN=
# Ваш числовой ID (узнать: @userinfobot). Можно несколько через запятую
ADMIN_IDS=
# Токен приложения: @CryptoBot -> Crypto Pay -> Create App
CRYPTOBOT_TOKEN=

SHOP_NAME=Мой магазин
SUPPORT_USERNAME=ваш_username_без_собаки

# Придумайте длинную случайную строку (для проверки вебхука Telegram)
WEBHOOK_SECRET=

# Оставьте пустым локально. На Render подставится автоматически.
PUBLIC_URL=

# Локально можно не трогать — будет файл bot.db.
# На Render впишите строку подключения к бесплатному Postgres (см. README).
DATABASE_URL=

# Какие монеты принимать
CRYPTOBOT_ASSETS=USDT,TON
